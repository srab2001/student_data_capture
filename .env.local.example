# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets or connection strings.

# Neon Postgres connection string (pooled, serverless-safe) for the DEV
# branch only. Never point this at a database containing real student
# data during the prototype phase — see docs/compliance.md.
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/iep_capture_dev?sslmode=require"

# Secret used to sign auth session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Restrict sign-in to the district's Google Workspace domain once SSO is
# wired up in Phase 5. Leave unset until then.
ALLOWED_GOOGLE_WORKSPACE_DOMAIN="hcpss.org"

# Server-side only key for the goal wizard and accommodation chat
# (app/api/ai/). Never expose this as a NEXT_PUBLIC_ variable — it must
# never reach the browser bundle. See docs/compliance.md "AI-assisted
# features" for what this app is and is not allowed to send with it: no
# student name/ID, no narrative notes, synthetic data only until the
# Track B gates there clear.
ANTHROPIC_API_KEY="replace-with-a-real-key"

# Optional: override the model used by the AI features for local testing.
# Defaults to the current Sonnet model if unset.
# ANTHROPIC_MODEL="claude-sonnet-5"
